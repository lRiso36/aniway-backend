@baseUrl = http://localhost:5000/api/v1/users

### create user
POST {{baseUrl}}
Content-Type: application/json

{
    "username": "testuser3",
    "email": "test3@example.com",
    "password": "hey"
}


### list users
GET {{baseUrl}}?username=testuser1


### set cookies & login
# @name login
POST http://localhost:5000/api/v1/auth/login
Content-Type: application/json

{
  "email": "lenaderiso22@gmail.com",
  "password": "password123"
}

###

@accessToken = {{login.response.body.data.accessToken}}

### me
GET {{baseUrl}}/me
Authorization: Bearer {{accessToken}}
          

### Update user
PUT {{baseUrl}}
Content-Type: application/json

{
  "id": "6aa88e189d4f04eac88d6faf",
  "username": "newname",
  "email": "new@example.com",
  "displayName": "New Name",
  "bio": "updated bio",
  "avatar": "",
  "isPrivate": false,
  "isVerified": true
}